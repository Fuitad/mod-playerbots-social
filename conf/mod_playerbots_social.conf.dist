[worldserver]

# Enable interactive Playerbot social behavior. Default: 0
PlayerbotsSocial.Enable = 0

# Rollout stage. Supported values: human_replies, grounded_presence, bounded_continuation,
# autonomous_society. Default: human_replies
PlayerbotsSocial.Stage = human_replies

# Conversation density profile. Supported values: quiet, normal, lively. Default: normal
PlayerbotsSocial.Density = normal

# Density multipliers. Invalid values fall back to the documented defaults.
PlayerbotsSocial.DensityMultiplier.Quiet = 0.55
PlayerbotsSocial.DensityMultiplier.Normal = 1.00
PlayerbotsSocial.DensityMultiplier.Lively = 1.60

# Pressure multiplier for autonomous General conversation starters. Default: 0.55
PlayerbotsSocial.GeneralStarterPressureMultiplier = 0.55

# Seconds of scope silence at which ambient starter pressure saturates, so a quiet
# channel converges on roughly one ambient line per interval. Zero falls back to the default. Default: 300
PlayerbotsSocial.AmbientCadenceSeconds = 300

# Applied only while the stage is autonomous_society. How many consecutive bot-only turns a thread
# may run, and the per-turn pressure decay while it does. Earlier stages keep the built-in cap of 2
# and decay of 0.62. Defaults: 6 and 0.95
PlayerbotsSocial.Autonomous.MaxConsecutiveBotTurns = 6
PlayerbotsSocial.Autonomous.BotTurnDecay = 0.95

# Participation base for a bot-only continuation while the stage is autonomous_society, so a bot
# conversation's early turns continue with real probability and threads reach conversational
# length. Threads a human participates in always use the built-in base of 0.45. Range (0, 1].
# Default: 0.95
PlayerbotsSocial.Autonomous.ContinuationPressureBase = 0.95

# Reply cooldown for a bot answering in a BOT-ONLY thread while the stage is autonomous_society,
# so two bots can alternate turns (the built-in 45s rail forbids A-B-A at conversational latency).
# Any thread a human has spoken in keeps the built-in 45s cooldown. Range [1, 45]; out-of-range
# values fall back. Default: 3
PlayerbotsSocial.Autonomous.BotReplyCooldownSeconds = 3

# Relationship-driven whisper check-ins, applied only while the stage is autonomous_society.
# MinFamiliarity is how warm a pair must be before a bot may open a whisper; PairCooldownSeconds is
# how long a pair rests between check-ins. Defaults: 0.01 and 21600 (6 hours)
PlayerbotsSocial.Whisper.MinFamiliarity = 0.01
PlayerbotsSocial.Whisper.PairCooldownSeconds = 21600

# How long a PLAYER rests between bot-initiated check-ins, counted across every bot warm to them.
# PairCooldownSeconds rations one bot toward one person and nothing rations the person, so after a
# long logout every warm pair is off its window at once and each scan hands the same player another
# hello. Halve this for roughly two an hour. Whispers a player starts are replies and are never
# rationed here, and bots checking in on each other are not rationed by target at all.
# Zero falls back to the default. Default: 3600 (1 hour)
PlayerbotsSocial.Whisper.TargetCooldownSeconds = 3600

# Whether whisper conversations may feed idle memory extraction. What is persisted is an LLM
# paraphrase scoped to the (bot, person) pair, recalled only in later whispers between that same
# pair; raw whisper text lives only in the bounded transient buffer and is dropped at extraction,
# and a speaker's opt-out or reset purges it. Off restores the absolute rule: whisper text is never
# held in server memory at all. Default on for a single-operator server; hosting other humans is a
# reason to decide this deliberately. Default: 1
PlayerbotsSocial.WhisperMemory.Enable = 1

# Server-wide LLM provider call ceiling per hour, spent as a token bucket (a small burst plus a
# steady refill) so lively stays steady instead of a burst followed by silence. Requests beyond it
# are refused with the budget_exhausted reason; only a pathological refusal volume (twenty times
# the ceiling inside one hour) opens the durable budget circuit, which an operator closes by
# clearing budget_circuit_open in playerbot_social_runtime_control. Zero means no ceiling.
# Default: 120
PlayerbotsSocial.Provider.HourlyBudget = 120

# Social event retention in hours. Values below the privacy floor are raised to the floor. Default: 48
PlayerbotsSocial.TelemetryRetentionHours = 48

# Administrative control secret. Empty or short values refuse all control requests. Default: empty
PlayerbotsSocial.ControlToken = ""
